// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// 🔐 ส่วนที่เพิ่มใหม่สำหรับ NextAuth (Login System)
// =========================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================================
// 👤 ตารางผู้ใช้ (อัปเดตให้รองรับทั้ง Login & Gamification)
// =========================================================

model User {
  id                String    @id @default(cuid())
  name              String? // ✅ เพิ่ม: ชื่อจริง (จาก Google)
  username          String?   @unique // ปรับเป็น Optional เผื่อยังไม่ได้ตั้ง
  email             String?   @unique
  emailVerified     DateTime? // ✅ เพิ่ม: สถานะยืนยันอีเมล
  image             String?   @db.Text // รูปโปรไฟล์ (จาก Google หรือ Base64 Data URL)
  password          String? // ✅ เพิ่ม: เผื่อทำระบบรหัสผ่านในอนาคต
  createdAt         DateTime  @default(now())
  lastPlayedAt      DateTime?
  lastNameChangedAt DateTime? // ✅ เพิ่ม: วันที่เปลี่ยนชื่อล่าสุด (เช็ค 7 วัน)
  showInLeaderboard Boolean   @default(true) // ✅ เปิด/ปิด การแสดงตัวตนใน Leaderboard
  keyboardSound     String    @default("click") // ✅ ธีมเสียงแป้นพิมพ์ ('none' | 'click' | 'mechanical' | 'soft')
  isAvatarLocked    Boolean   @default(false) // ✅ ถูกล็อกไม่ให้เปลี่ยนรูปโปรไฟล์

  // --- NextAuth Relations ---
  accounts Account[]
  sessions Session[]

  // --- Gamification Data ---
  rank       Int @default(1) // 1, 2, 3
  stars      Int @default(0) // ดาวสะสม
  currentExp Int @default(0) // Exp ปัจจุบัน
  xp         Int @default(0) // เก็บค่าประสบการณ์รวม

  // --- App Relations ---
  progress    LessonProgress[]
  testResults SpeedTestResult[]
  feedbacks   Feedback[]
  reportsReceived Report[] @relation("ReportedUser")
  reportsSent     Report[] @relation("ReporterUser")

  @@index([email])
}

// =========================================================
// 💬 ตารางข้อเสนอแนะ (Feedback)
// =========================================================
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  String   @default("suggestion") // 'suggestion' | 'bug' | 'feature' | 'other'
  title     String
  content   String   @db.Text
  status    String   @default("pending") // 'pending' | 'reviewed' | 'resolved'
  createdAt DateTime @default(now())

  @@index([userId])
}

// =========================================================
// 🚨 ตารางการรายงานผู้ใช้ (User Reports)
// =========================================================
model Report {
  id             String   @id @default(cuid())
  reporterId     String?
  reporter       User?    @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUserId String
  reportedUser   User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         String   // 'inappropriate_name' | 'inappropriate_avatar' | 'cheating' | 'other'
  details        String?  @db.Text
  status         String   @default("pending") // 'pending' | 'resolved' | 'dismissed'
  createdAt      DateTime @default(now())

  @@index([reportedUserId])
}

// =========================================================
// 📚 ส่วนเนื้อหาบทเรียน (เหมือนเดิม)
// =========================================================

// 2. ตารางบทเรียนหลัก (เช่น "บทเรียน 1: แป้นเหย้า")
model Lesson {
  id    Int    @id @default(autoincrement())
  title String // ชื่อบทเรียน
  level String // 'beginner', 'intermediate', 'advanced'
  order Int // ลำดับการเรียง (1, 2, 3...)
  slug  String @unique

  subLessons SubLesson[]
}

// 3. ตารางด่านย่อย (เช่น "b1a", "b1b")
model SubLesson {
  id      String @id // รหัสที่เราตั้งเอง เช่น "b1a"
  title   String // ชื่อด่าน (ถ้ามี) หรือใช้ลำดับเอา
  content String // ข้อความที่จะให้พิมพ์ (Text)
  mode    String @default("word")
  order   Int

  lessonId Int
  newKeys  String[] @default([])
  lesson   Lesson   @relation(fields: [lessonId], references: [id])

  userProgress LessonProgress[]
}

// 4. ตารางบันทึกผลการเล่น (ใครเล่นด่านไหน ได้กี่คะแนน)
model LessonProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  subLessonId String
  subLesson   SubLesson @relation(fields: [subLessonId], references: [id])

  wpm      Int    @default(0)
  accuracy Float  @default(0)
  stars    Int    @default(0) // ดาวที่ได้ในด่านนี้ (1-3)
  duration Int    @default(0)
  status   String @default("completed") // completed

  updatedAt DateTime @updatedAt

  @@unique([userId, subLessonId]) // ห้าม User คนเดิมบันทึกด่านเดิมซ้ำ (ให้ update แทน)
  @@index([userId])
}

model SpeedTestResult {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  duration Int // ระยะเวลาที่เลือก (1, 3, หรือ 5 นาที)
  wpm      Int // ความเร็ว
  accuracy Int // ความแม่นยำ
  mistakes Json // ✅ เก็บตัวที่พิมพ์ผิด (เช่น {"ก": 5, "ข": 2}) ไว้ทำกราฟแท่ง

  createdAt DateTime @default(now())
}
